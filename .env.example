# Discord Bot Token (from https://discord.com/developers/applications)
DISCORD_TOKEN=your_discord_bot_token_here

# GitHub Webhook Secret (for deployment webhook verification)
GITHUB_SECRET=your_webhook_secret_here

# Discord Channel ID for bot startup/update notifications
LOG_CHANNEL_ID=your_log_channel_id_here

# Discord Channel ID for admin action audit logs (optional)
ADMIN_LOG_CHANNEL_ID=your_admin_log_channel_id_here

# Discord Channel ID for new-member welcome messages (optional)
WELCOME_CHANNEL_ID=your_welcome_channel_id_here
